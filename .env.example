# Copie para .env e ajuste os valores.
DATABASE_URL=postgresql+psycopg://helpdesk:helpdesk@localhost:5432/helpdesk
TEST_DATABASE_URL=postgresql+psycopg://helpdesk:helpdesk@localhost:5432/helpdesk_test

# Gere uma chave forte, por exemplo: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria
JWT_EXPIRE_MINUTES=60

# Triagem por IA (opcional). Sem chave, o sistema usa o classificador por palavras-chave.
ANTHROPIC_API_KEY=
TRIAGE_MODEL=claude-opus-5-5
